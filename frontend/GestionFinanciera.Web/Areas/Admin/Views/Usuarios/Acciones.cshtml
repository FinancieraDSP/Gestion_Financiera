@model UsuarioAdmin
@{
    ViewData["Title"] = "Acciones de usuario";
    var esAdmin = Model.Rol == "Administrador";
}
<div class="topbar">
    <div><h1>Gestión de usuarios</h1><p>Ver, buscar y administrar cuentas</p></div>
</div>

<div class="modal-backdrop">
    <div class="modal-box">
        <div class="modal-user">
            <div class="modal-avatar">@Model.Iniciales</div>
            <div>
                <p style="font-size:13px;font-weight:600;color:var(--navy);margin:0;">@Model.Nombre</p>
                <p style="font-size:11px;color:var(--text-muted-2);margin:0;">@Model.Correo</p>
            </div>
        </div>

        @if (esAdmin)
        {
            <p style="font-size:11px;color:var(--text-muted);margin:10px 0 14px;">
                Las cuentas de administrador no se pueden bloquear, restablecer ni eliminar desde este panel.
            </p>
        }
        else
        {
            <p style="font-size:11px;color:var(--text-muted);margin:10px 0 14px;">Selecciona una acción para esta cuenta.</p>

            <div style="display:flex;flex-direction:column;gap:8px;">
                @if (Model.Activo)
                {
                    <form asp-action="Bloquear" asp-route-id="@Model.Id" method="post">
                        <button type="submit" class="modal-action-btn neutral"><i class="ti ti-lock"></i>Bloquear cuenta</button>
                    </form>
                }
                else
                {
                    <form asp-action="Desbloquear" asp-route-id="@Model.Id" method="post">
                        <button type="submit" class="modal-action-btn positive"><i class="ti ti-lock-open"></i>Desbloquear cuenta</button>
                    </form>
                }
                <form asp-action="Restablecer" asp-route-id="@Model.Id" method="post"
                      onsubmit="return confirm('Se generará una contraseña temporal y la actual dejará de funcionar. ¿Continuar?');">
                    <button type="submit" class="modal-action-btn neutral"><i class="ti ti-key"></i>Restablecer contraseña</button>
                </form>
                <form asp-action="Eliminar" asp-route-id="@Model.Id" method="post"
                      onsubmit="return confirm('Se eliminará la cuenta y TODOS sus datos (cuentas, ingresos, gastos, metas, deudas). Esta acción no se puede deshacer. ¿Continuar?');">
                    <button type="submit" class="modal-action-btn negative"><i class="ti ti-trash"></i>Eliminar cuenta</button>
                </form>
            </div>
        }

        <div class="modal-privacy-note">
            <p><i class="ti ti-eye-off" style="margin-right:4px;"></i>Como administrador no puedes ver los movimientos financieros de este usuario.</p>
        </div>

        <div class="card-dark" style="margin-top:14px;padding:10px 12px;">
            <div class="admin-detail-grid">
                <span>Rol: <b>@Model.Rol</b></span>
                <span>Estado: <b style="color:@(Model.Activo ? "var(--mint)" : "var(--red)");">@(Model.Activo ? "Activo" : "Bloqueado")</b></span>
                <span>Registro: <b>@Model.FechaRegistro.ToString("dd/MM/yy")</b></span>
                <span>Categorías creadas: <b>@Model.CategoriasCreadas</b></span>
            </div>
        </div>

        <div style="display:flex;justify-content:flex-end;margin-top:14px;">
            <a asp-action="Index" class="btn btn-ghost">Cerrar</a>
        </div>
    </div>
</div>