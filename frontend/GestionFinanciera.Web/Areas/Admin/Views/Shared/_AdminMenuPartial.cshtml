@{
    var controllerActual = ViewContext.RouteData.Values["controller"]?.ToString();
    string EsActivo(string nombreControlador) => controllerActual == nombreControlador ? "active" : "";
}
<aside class="sidebar sidebar-admin" id="sidebarMenu">
    <div class="sidebar-top">
        <div class="logo">
            <a class="@EsActivo("Dashboard")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><div class="mark"><i class="ti ti-wallet"></i></div></a>
            <span>FinanzApp · Admin</span>
        </div>
        <a href="#" class="menu-close" id="btnCerrarMenu"><i class="ti ti-x"></i></a>
    </div>

    <nav>
        <a class="@EsActivo("Dashboard")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="ti ti-layout-dashboard"></i>Panel general</a>
        <a class="@EsActivo("Usuarios")" asp-area="Admin" asp-controller="Usuarios" asp-action="Index"><i class="ti ti-users"></i>Gestión de usuarios</a>
        <a class="@EsActivo("Configuracion")" asp-area="Admin" asp-controller="Configuracion" asp-action="Index"><i class="ti ti-settings"></i>Configuración</a>
    </nav>

    <div class="bottom">
        <a class="@EsActivo("Perfil")" asp-area="Admin" asp-controller="Perfil" asp-action="CambiarContrasena"><i class="ti ti-key"></i>Cambiar contraseña</a>
        <a asp-area="" asp-controller="Account" asp-action="Logout"><i class="ti ti-logout"></i>Cerrar sesión</a>
    </div>
</aside>
