@model GestionFinancieraPersonal.Models.CambiarContrasenaViewModel
@{
    ViewData["Title"] = "Cambiar contraseña";
}
<div class="topbar">
    <div><h1>Cambiar contraseña</h1><p>Actualiza la clave de tu cuenta de administrador</p></div>
    <div class="role-badge desktop-only"><i class="ti ti-shield-check"></i>Administrador</div>
</div>

@if (TempData["Exito"] is string exito)
{
    <div class="alert success" style="margin-top:12px;"><i class="ti ti-circle-check"></i>@exito</div>
}

<form asp-area="Admin" asp-controller="Perfil" asp-action="CambiarContrasena" method="post" class="card form-narrow">
    <div class="form-group">
        <label asp-for="ContrasenaActual">Contraseña actual</label>
        <input asp-for="ContrasenaActual" type="password" autocomplete="current-password" />
        <span asp-validation-for="ContrasenaActual" class="field-error"></span>
    </div>
    <div class="form-group">
        <label asp-for="NuevaContrasena">Nueva contraseña</label>
        <input asp-for="NuevaContrasena" type="password" placeholder="Mínimo 6 caracteres" autocomplete="new-password" />
        <span asp-validation-for="NuevaContrasena" class="field-error"></span>
    </div>
    <div class="form-group">
        <label asp-for="ConfirmarContrasena">Confirmar nueva contraseña</label>
        <input asp-for="ConfirmarContrasena" type="password" autocomplete="new-password" />
        <span asp-validation-for="ConfirmarContrasena" class="field-error"></span>
    </div>

    <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:12px;">
        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="btn btn-ghost">Cancelar</a>
        <button type="submit" class="btn btn-primary">Cambiar contraseña</button>
    </div>
</form>