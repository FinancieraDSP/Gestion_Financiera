@{
    ViewData["Title"] = (string)ViewBag.Titulo;
    Layout = "_LoginLayout";
}
<div class="login-card">
    <div class="login-right" style="text-align:center;">
        <div style="font-size:42px;font-weight:700;color:var(--mint);">@ViewBag.Codigo</div>
        <p class="login-title">@ViewBag.Titulo</p>
        <p class="login-subtitle">@ViewBag.Mensaje</p>
        <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-block">Volver al inicio</a>
    </div>
</div>