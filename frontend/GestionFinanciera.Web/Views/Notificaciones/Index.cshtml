@using GestionFinancieraPersonal.Entidades
@model List<Notificacion>

@{
    ViewData["Title"] = "Notificaciones";

    string Icono(string tipo) => tipo switch
    {
        "Presupuesto" => "ti-alert-triangle",
        "Meta" => "ti-target",
        "Deuda" => "ti-credit-card",
        "Mantenimiento" => "ti-tool",
        _ => "ti-bell"
    };
}

<div class="topbar">
    <div>
        <h1>Notificaciones</h1>
        <p>Alertas de tu presupuesto, metas y deudas</p>
    </div>

    @await Component.InvokeAsync("Campana", new { claseExtra = "desktop-only" })
</div>

@if (TempData["Exito"] is string exito)
{
    <div class="alert success">
        <i class="ti ti-circle-check"></i>
        @exito
    </div>
}

@if (Model.Any())
{
    <div class="notif-actions">

        <form asp-action="MarcarTodasLeidas" method="post" style="margin:0;">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-ghost">
                <i class="ti ti-checks"></i>
                Marcar todas como leídas
            </button>
        </form>

        <form asp-action="EliminarTodas"
              method="post"
              style="margin:0;"
              onsubmit="return confirm('¿Eliminar TODAS las notificaciones? Esta acción no se puede deshacer.');">
            @Html.AntiForgeryToken()

            <button type="submit"
                    class="btn btn-ghost"
                    style="color:var(--red);">
                <i class="ti ti-trash"></i>
                Eliminar todas
            </button>
        </form>

    </div>
}

<div style="margin-top:12px;">

    @foreach (var n in Model)
    {
        <div class="card"
             style="border-left:3px solid @(n.Leida ? "var(--border)" : "var(--mint)");
                    margin-bottom:8px;">

            <div style="display:flex;gap:10px;align-items:flex-start;">

                <i class="ti @Icono(n.Tipo)"
                   style="color:var(--mint);font-size:18px;margin-top:1px;">
                </i>

                <div style="flex:1;">
                    <p style="margin:0;font-size:12.5px;font-weight:@(n.Leida ? 500 : 700);color:var(--navy);">
                        @n.Titulo
                    </p>

                    <p style="margin:2px 0 0;font-size:12px;color:var(--text-muted);">
                        @n.Mensaje
                    </p>
                </div>

                <div class="notif-item-actions">

                    @if (!n.Leida)
                    {
                        <form asp-action="MarcarLeida"
                              asp-route-id="@n.IdNotificacion"
                              method="post"
                              style="margin:0;">
                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn-icon-danger"
                                    style="color:var(--mint);"
                                    title="Marcar como leída">
                                <i class="ti ti-check"></i>
                            </button>
                        </form>
                    }

                    <form asp-action="Eliminar"
                          asp-route-id="@n.IdNotificacion"
                          method="post"
                          style="margin:0;">
                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn-icon-danger"
                                title="Eliminar">
                            <i class="ti ti-trash"></i>
                        </button>
                    </form>

                    <span style="font-size:10.5px;color:var(--text-muted);white-space:nowrap;">
                        @n.Fecha.ToString("dd/MM/yy HH:mm")
                    </span>
                </div>

            </div>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card">
            <p class="note" style="margin:0;">
                No tienes notificaciones por ahora.
            </p>
        </div>
    }

</div>