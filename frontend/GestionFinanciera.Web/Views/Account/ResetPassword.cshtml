@model GestionFinancieraPersonal.Models.ResetPasswordViewModel

@{
    ViewData["Title"] = "Restablecer contraseña";
    Layout = "_LoginLayout";
}

<div class="login-card">

    <div class="login-left">
        <div class="mark login-mark">
            <i class="ti ti-key"></i>
        </div>

        <p class="login-brand">
            Gestión Financiera
        </p>

        <p class="login-tagline">
            Define una nueva contraseña para tu cuenta.
        </p>
    </div>

    <div class="login-right">

        <p class="login-title">
            Nueva contraseña
        </p>

        <p class="login-subtitle">
            Este enlace solo puede utilizarse una vez.
        </p>

        <form asp-action="ResetPassword"
              method="post">

            <input asp-for="Token" type="hidden" />

            <div class="form-group">
                <label asp-for="NuevaContrasena">
                    Nueva contraseña
                </label>

                <input asp-for="NuevaContrasena"
                       type="password" />

                <span asp-validation-for="NuevaContrasena"
                      class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmarContrasena">
                    Confirmar contraseña
                </label>

                <input asp-for="ConfirmarContrasena"
                       type="password" />

                <span asp-validation-for="ConfirmarContrasena"
                      class="field-error"></span>
            </div>

            @if (!string.IsNullOrEmpty(Model.MensajeError))
            {
                <div class="alert danger">
                    <i class="ti ti-alert-circle"></i>
                    @Model.MensajeError
                </div>
            }

            <button type="submit"
                    class="btn btn-primary btn-block">
                Guardar contraseña
            </button>

        </form>

    </div>

</div>