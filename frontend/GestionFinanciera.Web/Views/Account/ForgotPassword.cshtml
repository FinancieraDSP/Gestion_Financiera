@model ForgotPasswordViewModel

@{
    ViewData["Title"] = "Recuperar contraseña";
    Layout = "_LoginLayout";
}

<div class="login-card">

    <div class="login-left">
        <div class="mark login-mark">
            <i class="ti ti-mail"></i>
        </div>

        <p class="login-brand">
            Gestión financiera
        </p>

        <p class="login-tagline">
            Te enviaremos un enlace temporal para restablecer tu contraseña.
        </p>
    </div>

    <div class="login-right">

        <p class="login-title">
            Recuperar contraseña
        </p>

        <p class="login-subtitle">
            Ingresa el correo asociado a tu cuenta.
        </p>

        <form asp-action="ForgotPassword" method="post">

            <div class="form-group">
                <label asp-for="Correo">
                    Correo electrónico
                </label>

                <input asp-for="Correo"
                       type="email"
                       placeholder="nombre@correo.com" />

                <span asp-validation-for="Correo"
                      class="field-error"></span>
            </div>

            @if (!string.IsNullOrEmpty(Model.MensajeExito))
            {
                <div class="alert success">
                    <i class="ti ti-circle-check"></i>
                    @Model.MensajeExito
                </div>
            }

            <button type="submit"
                    class="btn btn-primary btn-block">
                Enviar enlace
            </button>

            <p class="login-subtitle"
               style="margin:14px 0 0;text-align:center;">

                <a asp-action="Login"
                   style="color:var(--mint);">
                    Volver al inicio de sesión
                </a>

            </p>

        </form>

    </div>

</div>