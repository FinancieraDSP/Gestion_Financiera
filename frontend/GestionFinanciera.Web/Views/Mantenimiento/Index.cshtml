@using System.Globalization
@model GestionFinancieraPersonal.Servicios.InfoMantenimiento
@{
    Layout = null;
    var c = CultureInfo.InvariantCulture;
    var inicio = Model.Inicio!.Value;
    var fin = Model.Fin!.Value;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mantenimiento - Gestión Financiera</title>
    <link rel="stylesheet" href="~/lib/tabler-icons/tabler-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @* Mismo concepto visual que la pantalla "Sin conexión" (clases offline-*) *@
    <div class="offline-screen visible" role="alert">
        <div class="offline-box">
            <i class="ti ti-tool offline-icon"></i>
            <p class="offline-title">Sistema en mantenimiento</p>
            <p class="offline-text">Estamos realizando mejoras en la plataforma. Volverá a estar disponible al finalizar el mantenimiento.</p>
            <p class="offline-text">
                Inicio: @inicio.ToString("dd/MM/yyyy", c) · @inicio.ToString("h:mm tt", c)<br />
                Finalización: @fin.ToString("dd/MM/yyyy", c) · @fin.ToString("h:mm tt", c)<br />
                Horario: @inicio.ToString("h:mm tt", c) – @fin.ToString("h:mm tt", c)
            </p>
            <a asp-controller="Mantenimiento" asp-action="Index" class="btn btn-primary"><i class="ti ti-refresh"></i>Reintentar</a>
        </div>
    </div>
</body>
</html>
