<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin · Gestión Financiera</title>
    <link rel="stylesheet" href="~/lib/tabler-icons/tabler-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
    <div class="app">
        @await Html.PartialAsync("_AdminMenuPartial")

        <div class="app-content">
            <div class="mobile-topbar">
                <button class="hamburger" id="btnMenu" aria-label="Abrir menú"><i class="ti ti-menu-2"></i></button>
                <span class="mobile-topbar-title">@ViewData["Title"]</span>
                <div class="role-badge"><i class="ti ti-shield-check"></i>Admin</div>
            </div>

            <main class="main">
                @RenderBody()
            </main>
        </div>
    </div>

    <div class="menu-overlay" id="menuOverlay"></div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
