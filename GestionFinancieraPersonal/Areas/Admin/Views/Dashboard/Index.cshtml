@model List<CategoriaGeneral>
@{
    ViewData["Title"] = "Panel de administración";
    var usoCategorias = Model.Where(c => c.Tipo == "Gasto" && c.Activa).OrderByDescending(c => c.PorcentajeUso).Take(5).ToList();
    var movimientos = (List<int>)ViewBag.MovimientosPorMes;
    var etiquetas = (List<string>)ViewBag.MesesEtiquetas;
    var maxMov = movimientos.Max();
}
<div class="topbar">
    <div><h1>Panel de administración</h1><p>Estadísticas globales y categorías del sistema</p></div>
    <div class="role-badge desktop-only"><i class="ti ti-shield-check"></i>Administrador</div>
</div>

@if (TempData["Exito"] is string exito)
{
    <div class="alert success" style="margin-bottom:12px;"><i class="ti ti-circle-check"></i>@exito</div>
}
@if (TempData["Error"] is string errorTemp)
{
    <div class="alert danger" style="margin-bottom:12px;"><i class="ti ti-alert-circle"></i>@errorTemp</div>
}

<div class="kpi-grid">
    <div class="kpi navy"><p class="label">Usuarios totales</p><p class="value white">@ViewBag.UsuariosTotales</p></div>
    <div class="kpi dark"><p class="label">Usuarios activos</p><p class="value mint">@ViewBag.UsuariosActivos</p></div>
    <div class="kpi dark"><p class="label">Categorías activas</p><p class="value white">@ViewBag.CategoriasActivas</p></div>
    <div class="kpi dark"><p class="label">Registros hoy</p><p class="value mint">@ViewBag.RegistrosHoy</p></div>
</div>

<div class="grid-2">
    <div class="card">
        <h2>Uso de categorías de gasto (todos los usuarios)</h2>
        @foreach (var c in usoCategorias)
        {
            <div class="bar-row">
                <div class="labels"><span>@c.Nombre</span><span>@c.PorcentajeUso%</span></div>
                <div class="bar-track"><div class="bar-fill mint" style="width:@(c.PorcentajeUso)%;"></div></div>
            </div>
        }
        @if (!usoCategorias.Any())
        {
            <p class="note">Aún no hay categorías de gasto.</p>
        }
        <p class="note">Datos agregados, sin acceso a movimientos individuales.</p>
    </div>
    <div class="card">
        <h2>Categorías generales</h2>
        <div class="data-scroll">
            <table class="data">
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr style="@(c.Activa ? "" : "opacity:.5;")">
                            <td>
                                <i class="ti ti-tag" style="color:var(--mint);margin-right:6px;"></i>@c.Nombre
                                <span class="pill @(c.Tipo == "Gasto" ? "warn" : "ok")" style="margin-left:6px;">@c.Tipo</span>
                            </td>
                            <td style="text-align:right;white-space:nowrap;">
                                <a asp-area="Admin" asp-controller="Categorias" asp-action="Editar" asp-route-id="@c.Id"
                                   style="color:var(--text-muted-2);margin-right:8px;" title="Editar"><i class="ti ti-pencil"></i></a>
                                <form asp-area="Admin" asp-controller="Categorias" asp-action="Alternar" asp-route-id="@c.Id" method="post" style="display:inline;">
                                    <button type="submit" class="btn-icon-danger" style="color:var(--text-muted-2);"
                                            title="@(c.Activa ? "Desactivar" : "Activar")">
                                        <i class="ti @(c.Activa ? "ti-trash" : "ti-restore")"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <form asp-area="Admin" asp-controller="Categorias" asp-action="Crear" method="post"
              style="display:flex;gap:6px;margin-top:10px;flex-wrap:wrap;">
            <input type="text" name="Nombre" placeholder="Nueva categoría" maxlength="100" required
                   style="flex:1;min-width:120px;height:32px;border-radius:8px;border:1px solid #D3DAE1;padding:0 10px;font-size:12px;" />
            <select name="Tipo" style="height:32px;border-radius:8px;border:1px solid #D3DAE1;font-size:12px;padding:0 6px;">
                <option value="Gasto">Gasto</option>
                <option value="Ingreso">Ingreso</option>
            </select>
            <button type="submit" class="btn btn-primary">Agregar</button>
        </form>
    </div>
</div>

<div class="card">
    <h2>Comparación mensual de la plataforma</h2>
    <div style="display:flex;gap:8px;">
        @for (var i = 0; i < movimientos.Count; i++)
        {
            var alturaPct = maxMov == 0 ? 0 : Math.Round((double)movimientos[i] / maxMov * 100, 0);
            <div style="flex:1;text-align:center;">
                <div style="height:70px;display:flex;align-items:flex-end;">
                    <div style="width:100%;background:var(--mint);height:@(alturaPct)%;min-height:2px;border-radius:3px 3px 0 0;"></div>
                </div>
                <p style="font-size:10px;margin:4px 0 0;color:var(--text-muted);">@etiquetas[i]</p>
                <p style="font-size:10.5px;margin:0;font-weight:600;color:var(--navy);">@movimientos[i]</p>
            </div>
        }
    </div>
    <p class="note">Total de movimientos registrados por todos los usuarios, por mes.</p>
</div>