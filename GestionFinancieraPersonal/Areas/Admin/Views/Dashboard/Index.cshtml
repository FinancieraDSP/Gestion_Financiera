@model List<CategoriaGeneral>
@{
    ViewData["Title"] = "Panel de administración";
}
<div class="topbar">
    <div><h1>Panel de administración</h1><p>Estadísticas globales y categorías del sistema</p></div>
    <div class="role-badge desktop-only"><i class="ti ti-shield-check"></i>Administrador</div>
</div>

<div class="kpi-grid">
    <div class="kpi navy"><p class="label">Usuarios totales</p><p class="value white">@ViewBag.UsuariosTotales</p></div>
    <div class="kpi dark"><p class="label">Usuarios activos</p><p class="value mint">@ViewBag.UsuariosActivos</p></div>
    <div class="kpi dark"><p class="label">Categorías activas</p><p class="value white">@ViewBag.CategoriasActivas</p></div>
    <div class="kpi dark"><p class="label">Registros hoy</p><p class="value mint">@ViewBag.RegistrosHoy</p></div>
</div>

<div class="grid-2">
    <div class="card">
        <h2>Uso de categorías (todos los usuarios)</h2>
        @foreach (var c in Model)
        {
            <div class="bar-row">
                <div class="labels"><span>@c.Nombre</span><span>@c.PorcentajeUso%</span></div>
                <div class="bar-track"><div class="bar-fill mint" style="width:@(c.PorcentajeUso)%;"></div></div>
            </div>
        }
        <p class="note">Datos agregados, sin acceso a movimientos individuales.</p>
    </div>
    <div class="card">
        <h2>Categorías generales</h2>
        <div class="data-scroll">
            <table class="data">
                <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td><i class="ti ti-tag" style="color:var(--mint);margin-right:6px;"></i>@c.Nombre</td>
                        <td style="text-align:right;">
                            <a href="#" style="color:var(--text-muted-2);margin-right:8px;"><i class="ti ti-pencil"></i></a>
                            <a href="#" style="color:var(--text-muted-2);"><i class="ti ti-trash"></i></a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card">
    <h2>Comparación mensual de la plataforma</h2>
    @{ var maxMov = ((List<int>)ViewBag.MovimientosPorMes).Max(); }
    <div style="display:flex;align-items:flex-end;gap:8px;height:70px;">
        @foreach (var mov in (List<int>)ViewBag.MovimientosPorMes)
        {
            var alturaPct = maxMov == 0 ? 0 : Math.Round((double)mov / maxMov * 100, 0);
            <div style="flex:1;background:var(--mint);height:@(alturaPct)%;border-radius:3px 3px 0 0;"></div>
        }
    </div>
    <p class="note">Total de movimientos registrados por todos los usuarios, por mes.</p>
</div>
