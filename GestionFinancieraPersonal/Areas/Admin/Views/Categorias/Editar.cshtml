@model CategoriaFormViewModel
@{
    ViewData["Title"] = "Editar categoría";
}
<div class="topbar">
    <div><h1>Editar categoría general</h1><p>Tipo: @Model.Tipo (no se puede cambiar)</p></div>
    <div class="role-badge desktop-only"><i class="ti ti-shield-check"></i>Administrador</div>
</div>

<form asp-area="Admin" asp-controller="Categorias" asp-action="Editar" method="post" class="card" style="max-width:520px;margin-top:12px;">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Tipo" />

    <div class="form-group">
        <label asp-for="Nombre">Nombre</label>
        <input asp-for="Nombre" type="text" />
        <span asp-validation-for="Nombre" class="field-error"></span>
    </div>
    <div class="form-group">
        <label asp-for="Descripcion">Descripción (opcional)</label>
        <input asp-for="Descripcion" type="text" />
        <span asp-validation-for="Descripcion" class="field-error"></span>
    </div>

    <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:12px;">
        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="btn btn-ghost">Cancelar</a>
        <button type="submit" class="btn btn-primary">Guardar</button>
    </div>
</form>