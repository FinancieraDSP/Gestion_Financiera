@model List<UsuarioAdmin>
@{
    ViewData["Title"] = "Gestión de usuarios";
}
<div class="topbar">
    <div><h1>Gestión de usuarios</h1><p>Ver, buscar y administrar cuentas</p></div>
    <div class="role-badge desktop-only"><i class="ti ti-shield-check"></i>Administrador</div>
</div>

@if (TempData["Exito"] is string exito)
{
    <div class="alert success" style="margin-bottom:12px;"><i class="ti ti-circle-check"></i>@exito</div>
}
@if (TempData["Error"] is string errorTemp)
{
    <div class="alert danger" style="margin-bottom:12px;"><i class="ti ti-alert-circle"></i>@errorTemp</div>
}

<div style="display:flex;justify-content:space-between;align-items:center;gap:8px;margin:12px 0 14px;flex-wrap:wrap;">
    <a asp-action="Crear" class="btn btn-primary"><i class="ti ti-user-plus"></i>Nuevo usuario</a>
    <form method="get" asp-area="Admin" asp-controller="Usuarios" asp-action="Index" style="flex:1;display:flex;justify-content:flex-end;">
        <input type="text" name="busqueda" placeholder="Buscar usuario..."
               style="height:32px;border-radius:8px;border:1px solid #D3DAE1;padding:0 10px;font-size:12px;width:100%;max-width:220px;" />
    </form>
</div>

<div class="card" style="padding:0;overflow:hidden;">
    <div class="data-scroll">
        <table class="data">
            <thead><tr><th>Nombre</th><th>Correo</th><th>Rol</th><th>Registro</th><th>Estado</th><th style="text-align:right;">Acciones</th></tr></thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td>@u.Nombre</td>
                        <td style="color:var(--text-muted);">@u.Correo</td>
                        <td>@u.Rol</td>
                        <td>@u.FechaRegistro.ToString("dd/MM/yy")</td>
                        <td>
                            @if (u.Activo)
                            {
                                <span class="pill ok">Activo</span>
                            }
                            else
                            {

                                <span class="pill warn">Bloqueado</span>
                            }
                        </td>
                        <td style="text-align:right;">
                            <a asp-action="Acciones" asp-route-id="@u.Id" style="color:var(--text-muted);" title="Ver acciones">
                                <i class="ti ti-settings"></i>
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" style="text-align:center;color:var(--text-muted);padding:18px;">No se encontraron usuarios.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>