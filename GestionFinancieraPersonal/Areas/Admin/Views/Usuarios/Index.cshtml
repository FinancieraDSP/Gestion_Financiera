@model List<UsuarioAdmin>
@{
    ViewData["Title"] = "Gestión de usuarios";
}
<div class="topbar">
    <div><h1>Gestión de usuarios</h1><p>Ver, buscar y administrar cuentas</p></div>
    <div class="role-badge desktop-only"><i class="ti ti-shield-check"></i>Administrador</div>
</div>

<form method="get" asp-area="Admin" asp-controller="Usuarios" asp-action="Index" style="display:flex;justify-content:flex-end;margin-bottom:14px;">
    <input type="text" name="busqueda" placeholder="Buscar usuario..." style="height:32px;border-radius:8px;border:1px solid #D3DAE1;padding:0 10px;font-size:12px;width:100%;max-width:220px;" />
</form>

<div class="card" style="padding:0;overflow:hidden;">
    <div class="data-scroll">
        <table class="data">
            <thead><tr><th>Nombre</th><th>Correo</th><th>Registro</th><th>Estado</th><th style="text-align:right;">Acciones</th></tr></thead>
            <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td>@u.Nombre</td>
                    <td style="color:var(--text-muted);">@u.Correo</td>
                    <td>@u.FechaRegistro.ToString("dd/MM/yy")</td>
                    <td>
                        @if (u.Activo)
                        {
                            <span class="pill ok">Activo</span>
                        }
                        else
                        {
                            <span class="pill warn">Suspendido</span>
                        }
                    </td>
                    <td style="text-align:right;">
                        <a asp-action="Acciones" asp-route-id="@u.Id" style="color:var(--text-muted);margin-right:10px;"><i class="ti ti-eye"></i></a>
                        <a asp-action="Acciones" asp-route-id="@u.Id" style="color:@(u.Activo ? "var(--text-muted)" : "var(--mint)");">
                            <i class="ti @(u.Activo ? "ti-lock" : "ti-lock-open")"></i>
                        </a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
