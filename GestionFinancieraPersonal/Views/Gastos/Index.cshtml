@model List<Gasto>
@{
    ViewData["Title"] = "Gastos";
}
<div class="topbar">
    <div><h1>Gestión de gastos</h1><p>Registro de salidas de dinero</p></div>
</div>

<div class="card" style="padding:0;overflow:hidden;margin-bottom:16px;">
    <table class="data">
        <thead><tr><th>Fecha</th><th>Categoría</th><th>Descripción</th><th>Método de pago</th><th>Monto</th></tr></thead>
        <tbody>
        @foreach (var g in Model)
        {
            <tr>
                <td>@g.Fecha.ToString("dd/MM/yy")</td>
                <td>@g.Categoria</td>
                <td>@g.Descripcion</td>
                <td>@g.MetodoPago</td>
                <td class="amount-neg">-@g.Monto.ToString("C")</td>
            </tr>
        }
        </tbody>
    </table>
</div>

<form asp-controller="Gastos" asp-action="Registrar" method="post" class="card-dark">
    <h2>Registrar nuevo gasto</h2>
    <div class="form-row">
        <div class="form-group">
            <label>Monto</label>
            <input name="Monto" type="text" placeholder="$0.00" />
            <span class="field-error">@ViewData.ModelState["Monto"]?.Errors.FirstOrDefault()?.ErrorMessage</span>
        </div>
        <div class="form-group"><label>Fecha</label><input type="text" value="@DateTime.Now.ToString("dd/MM/yyyy")" disabled /></div>
    </div>
    <div class="form-row">
        <div class="form-group">
            <label>Categoría</label>
            <select name="Categoria"><option>Alimentación</option><option>Salud</option><option>Educación</option><option>Entretenimiento</option></select>
        </div>
        <div class="form-group">
            <label>Método de pago</label>
            <select name="MetodoPago"><option>Efectivo</option><option>Tarjeta</option><option>Transferencia</option></select>
        </div>
    </div>
    <div class="form-row">
        <div class="form-group">
            <label>Descripción</label>
            <input name="Descripcion" type="text" placeholder="¿En qué se gastó?" />
            <span class="field-error">@ViewData.ModelState["Descripcion"]?.Errors.FirstOrDefault()?.ErrorMessage</span>
        </div>
    </div>
    <div style="display:flex;gap:8px;justify-content:flex-end;">
        <button type="submit" class="btn btn-primary">Guardar</button>
    </div>
</form>
