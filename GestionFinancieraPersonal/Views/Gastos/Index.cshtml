@using GestionFinancieraPersonal.Entidades
@model MovimientosViewModel<Gasto>
@{
    ViewData["Title"] = "Gastos";
    string Err(string campo) => ViewData.ModelState[campo]?.Errors.FirstOrDefault()?.ErrorMessage ?? "";
    var f = Model.Formulario;
}
<div class="topbar">
    <div><h1>Gestión de gastos</h1><p>Registro de salidas de dinero</p></div>
</div>

@if (TempData["Exito"] is string exito)
{
    <div class="alert success"><i class="ti ti-circle-check"></i>@exito</div>
}
@if (TempData["Error"] is string errorTemp)
{
    <div class="alert danger"><i class="ti ti-alert-circle"></i>@errorTemp</div>
}

<div class="card" style="padding:0;overflow:hidden;margin:12px 0 16px;">
    <table class="data">
        <thead><tr><th>Fecha</th><th>Categoría</th><th>Descripción</th><th>Cuenta</th><th>Monto</th><th></th></tr></thead>
        <tbody>
            @foreach (var g in Model.Items)
            {
                <tr>
                    <td>@g.Fecha.ToString("dd/MM/yy")</td>
                    <td>@g.Categoria.Nombre</td>
                    <td>@g.Descripcion</td>
                    <td>@g.Cuenta.Nombre</td>
                    <td class="amount-neg">-@g.Monto.ToString("C")</td>
                    <td>
                        <form asp-controller="Gastos" asp-action="Eliminar" asp-route-id="@g.IdGasto" method="post"
                              onsubmit="return confirm('¿Eliminar este gasto? Se devolverá el dinero a la cuenta.');" style="margin:0;">
                            <button type="submit" class="btn-icon-danger" title="Eliminar"><i class="ti ti-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Items.Any())
            {
                <tr><td colspan="6" style="text-align:center;color:var(--text-muted);padding:18px;">Aún no has registrado gastos.</td></tr>
            }
        </tbody>
    </table>
</div>

<form asp-controller="Gastos" asp-action="Registrar" method="post" class="card-dark">
    <h2>Registrar nuevo gasto</h2>

    @if (!string.IsNullOrEmpty(Err("")))
    {
        <div class="alert danger" style="margin-bottom:10px;"><i class="ti ti-alert-circle"></i>@Err("")</div>
    }

    <div class="form-row">
        <div class="form-group">
            <label>Monto</label>
            <input name="Monto" type="number" step="0.01" min="0.01" placeholder="$0.00" value="@f.Monto" />
            <span class="field-error">@Err("Monto")</span>
        </div>
        <div class="form-group">
            <label>Fecha</label>
            <input name="Fecha" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")" value="@(f.Fecha?.ToString("yyyy-MM-dd"))" />
            <span class="field-error">@Err("Fecha")</span>
        </div>
    </div>
    <div class="form-row">
        <div class="form-group">
            <label>Categoría</label>
            <select name="IdCategoria" asp-items="Model.Categorias"><option value="">Selecciona...</option></select>
            <span class="field-error">@Err("IdCategoria")</span>
                <a asp-controller="Categorias" asp-action="Index" style="font-size:10.5px;color:var(--mint);">+ Crear mi propia categoría</a>
        </div>
        <div class="form-group">
            <label>Cuenta</label>
            <select name="IdCuenta" asp-items="Model.Cuentas"><option value="">Selecciona...</option></select>
            <span class="field-error">@Err("IdCuenta")</span>
        </div>
    </div>
    <div class="form-row">
        <div class="form-group">
            <label>Descripción</label>
            <input name="Descripcion" type="text" placeholder="¿En qué se gastó?" value="@f.Descripcion" />
            <span class="field-error">@Err("Descripcion")</span>
        </div>
        <div class="form-group">
            <label>Comercio (opcional)</label>
            <input name="Detalle" type="text" placeholder="Ej. Súper Selectos" value="@f.Detalle" />
            <span class="field-error">@Err("Detalle")</span>
        </div>
    </div>
    <div style="display:flex;gap:8px;justify-content:flex-end;">
        <button type="submit" class="btn btn-primary">Guardar</button>
    </div>
</form>