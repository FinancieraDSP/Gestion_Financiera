@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_LoginLayout";
}
<div class="login-card">
    <div class="login-left">
        <div class="mark login-mark"><i class="ti ti-wallet"></i></div>
        <p class="login-brand">Gestión financiera</p>
        <p class="login-tagline">Controla tus ingresos, gastos y metas de ahorro desde un solo lugar.</p>
    </div>
    <div class="login-right">
        <p class="login-title">Iniciar sesión</p>
        <p class="login-subtitle">Ingresa tus credenciales para continuar</p>

        <form asp-controller="Account" asp-action="Login" method="post" novalidate>
            <div class="login-tabs">
                <label><input type="radio" asp-for="TipoAcceso" value="Usuario" />Usuario</label>
                <label><input type="radio" asp-for="TipoAcceso" value="Administrador" />Administrador</label>
            </div>

            <div class="form-group">
                <label asp-for="Correo">Correo electrónico</label>
                <input asp-for="Correo" type="text" placeholder="nombre@correo.com" />
                <span asp-validation-for="Correo" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Contrasena">Contraseña</label>
                <input asp-for="Contrasena" type="password" placeholder="••••••••" />
                <span asp-validation-for="Contrasena" class="field-error"></span>
            </div>

            @if (!string.IsNullOrEmpty(Model.MensajeError))
            {
                <div class="alert danger"><i class="ti ti-alert-circle"></i>@Model.MensajeError</div>
            }

            <div class="login-forgot"><span>¿Olvidaste tu contraseña?</span></div>
            <p class="login-subtitle" style="margin:14px 0 0;text-align:center;">
                ¿No tienes cuenta? <a asp-action="Registro" style="color:var(--mint);">Regístrate</a>
            </p>
            <button type="submit" class="btn btn-primary btn-block">Ingresar</button>
        </form>
    </div>
</div>
