@using GestionFinancieraPersonal.Entidades
@model AhorroViewModel
@{
    ViewData["Title"] = "Ahorro";
    string Err(string campo) => ViewData.ModelState[campo]?.Errors.FirstOrDefault()?.ErrorMessage ?? "";
    var meta = Model.NuevaMeta;
    var aporte = Model.Aporte;
}
<div class="topbar">
    <div><h1>Metas de ahorro</h1><p>Seguimiento de objetivos</p></div>
</div>

@if (TempData["Exito"] is string exito)
{
    <div class="alert success"><i class="ti ti-circle-check"></i>@exito</div>
}
@if (TempData["Error"] is string errorTemp)
{
    <div class="alert danger"><i class="ti ti-alert-circle"></i>@errorTemp</div>
}

<div class="grid-2" style="margin-top:12px;">
    @foreach (var m in Model.Metas)
    {
        <div class="card">
            <div class="goal-card">
                <div class="goal-icon"><i class="ti @m.Icono"></i></div>
                <div>
                    <p class="goal-name">@m.Nombre</p>
                    <p class="goal-date">@(m.FechaLimite.HasValue ? "Meta: " + m.FechaLimite.Value.ToString("dd/MM/yy") : "Sin fecha límite")</p>
                </div>
                <div style="margin-left:auto;display:flex;align-items:center;gap:6px;">
                    @if (m.Estado == "Completada") { <span class="pill ok">Completada</span> }
                    <form asp-controller="Ahorro" asp-action="EliminarMeta" asp-route-id="@m.IdMeta" method="post" style="margin:0;"
                          onsubmit="return confirm('¿Eliminar esta meta?@(m.MontoActual > 0 ? " Se devolverán " + m.MontoActual.ToString("C") + " a tu cuenta." : "")');">
                        <button type="submit" class="btn-icon-danger" title="Eliminar"><i class="ti ti-trash"></i></button>
                    </form>
                </div>
            </div>
            <div class="bar-track"><div class="bar-fill mint" style="width:@(Math.Min(m.Porcentaje, 100))%;"></div></div>
            <div class="goal-footer">
                <span class="goal-amount">@m.MontoActual.ToString("C") ahorrados</span>
                <span>Meta @m.MontoObjetivo.ToString("C")</span>
            </div>
        </div>
    }
    @if (!Model.Metas.Any())
    {
        <div class="card"><p class="note" style="margin:0;">Aún no tienes metas. Crea la primera abajo.</p></div>
    }
</div>

<div class="kpi navy kpi-total">
    <div><p class="label">Ahorro total acumulado</p><p class="value mint kpi-total-value">@Model.AhorroTotal.ToString("C")</p></div>
    <i class="ti ti-piggy-bank kpi-total-icon"></i>
</div>

<form asp-controller="Ahorro" asp-action="Aportar" method="post" class="card-dark" style="margin-top:16px;">
    <h2>Aportar a una meta</h2>
    @if (!Model.MetasActivas.Any())
    {
        <p style="font-size:12px;color:var(--text-muted-2);margin:0;">No tienes metas activas. Crea una para empezar a aportar.</p>
    }
    else
    {
        <div class="form-row">
            <div class="form-group">
                <label>Meta</label>
                <select name="IdMeta" asp-items="Model.MetasActivas"><option value="">Selecciona...</option></select>
                <span class="field-error">@Err("IdMeta")</span>
            </div>
            <div class="form-group">
                <label>Desde la cuenta</label>
                <select name="IdCuenta" asp-items="Model.Cuentas"><option value="">Selecciona...</option></select>
                <span class="field-error">@Err("IdCuenta")</span>
            </div>
        </div>
        <div class="form-group">
            <label>Monto a aportar</label>
            <input name="Monto" type="number" step="0.01" min="0.01" placeholder="$0.00" value="@aporte.Monto" />
            <span class="field-error">@Err("Monto")</span>
        </div>
        <div style="display:flex;gap:8px;justify-content:flex-end;">
            <button type="submit" class="btn btn-primary">Aportar</button>
        </div>
    }
</form>

<form asp-controller="Ahorro" asp-action="CrearMeta" method="post" class="card-dark" style="margin-top:16px;">
    <h2>Nueva meta</h2>
    <div class="form-row">
        <div class="form-group">
            <label>Nombre</label>
            <input name="Nombre" type="text" maxlength="100" placeholder="Ej. Fondo de emergencia" value="@meta.Nombre" />
            <span class="field-error">@Err("Nombre")</span>
        </div>
        <div class="form-group">
            <label>Monto objetivo</label>
            <input name="MontoObjetivo" type="number" step="0.01" min="0.01" placeholder="$0.00" value="@meta.MontoObjetivo" />
            <span class="field-error">@Err("MontoObjetivo")</span>
        </div>
    </div>
    <div class="form-row">
        <div class="form-group">
            <label>Fecha meta (opcional)</label>
            <input name="FechaLimite" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" value="@(meta.FechaLimite?.ToString("yyyy-MM-dd"))" />
            <span class="field-error">@Err("FechaLimite")</span>
        </div>
        <div class="form-group">
            <label>Ícono</label>
            <select name="Icono">
                <option value="ti-target" selected="@(meta.Icono == "ti-target")">General</option>
                <option value="ti-device-mobile" selected="@(meta.Icono == "ti-device-mobile")">Teléfono</option>
                <option value="ti-plane" selected="@(meta.Icono == "ti-plane")">Viaje</option>
                <option value="ti-device-laptop" selected="@(meta.Icono == "ti-device-laptop")">Laptop</option>
                <option value="ti-car" selected="@(meta.Icono == "ti-car")">Vehículo</option>
                <option value="ti-home" selected="@(meta.Icono == "ti-home")">Casa</option>
            </select>
        </div>
    </div>
    <div style="display:flex;gap:8px;justify-content:flex-end;">
        <button type="submit" class="btn btn-primary">Guardar</button>
    </div>
</form>