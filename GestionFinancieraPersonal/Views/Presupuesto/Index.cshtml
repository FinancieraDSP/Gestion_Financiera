@using GestionFinancieraPersonal.Entidades
@model PresupuestoViewModel
@{
    ViewData["Title"] = "Presupuesto";
    string Err(string campo) => ViewData.ModelState[campo]?.Errors.FirstOrDefault()?.ErrorMessage ?? "";
    var f = Model.Formulario;
    var total = Model.Presupuestos.Sum(p => p.MontoLimite);
    var gastado = Model.Presupuestos.Sum(p => p.MontoGastado);
    var disponible = total - gastado;
    var enAlerta = Model.Presupuestos.Where(p => p.EnAlerta).ToList();
}
<div class="topbar">
    <div><h1>Presupuesto mensual</h1><p>@Model.Periodo</p></div>
    @await Component.InvokeAsync("Campana", new { claseExtra = "desktop-only" })
</div>

@if (TempData["Exito"] is string exito)
{
    <div class="alert success"><i class="ti ti-circle-check"></i>@exito</div>
}
@if (TempData["Error"] is string errorTemp)
{
    <div class="alert danger"><i class="ti ti-alert-circle"></i>@errorTemp</div>
}

<div class="kpi-grid kpi-grid-3" style="margin-top:12px;">
    <div class="kpi navy"><p class="label">Presupuesto total</p><p class="value white">@total.ToString("C")</p></div>
    <div class="kpi dark"><p class="label">Gastado</p><p class="value red">@gastado.ToString("C")</p></div>
    <div class="kpi dark"><p class="label">Disponible</p><p class="value mint">@disponible.ToString("C")</p></div>
</div>

<div class="card">
    @foreach (var p in Model.Presupuestos)
    {
        <div class="bar-row">
            <div class="labels">
                <span>@p.Categoria.Nombre</span>
                <span>
                    @p.MontoGastado.ToString("C") / @p.MontoLimite.ToString("C")
                    <form asp-controller="Presupuesto" asp-action="Eliminar" asp-route-id="@p.IdPresupuesto" method="post" style="display:inline;"
                          onsubmit="return confirm('¿Eliminar el presupuesto de @p.Categoria.Nombre?');">
                        <button type="submit" class="btn-icon-danger" title="Eliminar"><i class="ti ti-trash"></i></button>
                    </form>
                </span>
            </div>
            <div class="bar-track"><div class="bar-fill @(p.EnAlerta ? "red" : "mint")" style="width:@(Math.Min(p.Porcentaje, 100))%;"></div></div>
        </div>
    }
    @if (!Model.Presupuestos.Any())
    {
        <p class="note">Aún no definiste presupuestos para este mes. Crea el primero abajo.</p>
    }
</div>

@foreach (var p in enAlerta)
{
    <div class="alert danger">
        <i class="ti ti-alert-triangle"></i>
        @(p.Porcentaje >= 100
            ? $"Superaste el presupuesto de {p.Categoria.Nombre} ({p.Porcentaje}% usado)."
            : $"Has usado el {p.Porcentaje}% del presupuesto de {p.Categoria.Nombre}.")
    </div>
}

<form asp-controller="Presupuesto" asp-action="Guardar" method="post" class="card-dark" style="margin-top:16px;">
    <h2>Definir presupuesto del mes</h2>
    <div class="form-row">
        <div class="form-group">
            <label>Categoría de gasto</label>
            <select name="IdCategoria" asp-items="Model.Categorias"><option value="">Selecciona...</option></select>
            <span class="field-error">@Err("IdCategoria")</span>
            <a asp-controller="Categorias" asp-action="Index" style="font-size:10.5px;color:var(--mint);">+ Crear mi propia categoría</a>
        </div>
        <div class="form-group">
            <label>Límite mensual</label>
            <input name="Limite" type="number" step="0.01" min="0.01" placeholder="$0.00" value="@f.Limite" />
            <span class="field-error">@Err("Limite")</span>
        </div>
    </div>
    <p style="font-size:10.5px;color:var(--text-muted-2);margin:0 0 10px;">Si ya existe un presupuesto para esa categoría este mes, se actualiza su límite.</p>
    <div style="display:flex;gap:8px;justify-content:flex-end;">
        <button type="submit" class="btn btn-primary">Guardar presupuesto</button>
    </div>
</form>