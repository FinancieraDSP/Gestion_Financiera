@model List<Ingreso>
@{
    ViewData["Title"] = "Ingresos";
}
<div class="topbar">
    <div><h1>Gestión de ingresos</h1><p>Registro de entradas de dinero</p></div>
</div>

<div class="card" style="padding:0;overflow:hidden;margin-bottom:16px;">
    <table class="data">
        <thead><tr><th>Fecha</th><th>Categoría</th><th>Descripción</th><th>Cuenta</th><th>Monto</th></tr></thead>
        <tbody>
        @foreach (var i in Model)
        {
            <tr>
                <td>@i.Fecha.ToString("dd/MM/yy")</td>
                <td>@i.Categoria</td>
                <td>@i.Descripcion</td>
                <td>@i.Cuenta</td>
                <td class="amount-pos">+@i.Monto.ToString("C")</td>
            </tr>
        }
        </tbody>
    </table>
</div>

<form asp-controller="Ingresos" asp-action="Registrar" method="post" class="card-dark">
    <h2>Registrar nuevo ingreso</h2>
    <div class="form-row">
        <div class="form-group">
            <label>Monto</label>
            <input name="Monto" type="text" placeholder="$0.00" />
            <span class="field-error">@ViewData.ModelState["Monto"]?.Errors.FirstOrDefault()?.ErrorMessage</span>
        </div>
        <div class="form-group"><label>Fecha</label><input type="text" value="@DateTime.Now.ToString("dd/MM/yyyy")" disabled /></div>
    </div>
    <div class="form-row">
        <div class="form-group">
            <label>Categoría</label>
            <select name="Categoria"><option>Salario</option><option>Freelance</option><option>Otros</option></select>
        </div>
        <div class="form-group">
            <label>Cuenta</label>
            <select name="Cuenta"><option>Cuenta principal</option><option>Ahorros</option></select>
        </div>
    </div>
    <div class="form-row">
        <div class="form-group">
            <label>Descripción</label>
            <input name="Descripcion" type="text" placeholder="¿De dónde viene?" />
            <span class="field-error">@ViewData.ModelState["Descripcion"]?.Errors.FirstOrDefault()?.ErrorMessage</span>
        </div>
    </div>
    <div style="display:flex;gap:8px;justify-content:flex-end;">
        <button type="submit" class="btn btn-primary">Guardar</button>
    </div>
</form>
